<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_taskminer" targetNamespace="http://taskminer.exemplo/bpmn">
  <bpmn:collaboration id="colaboracao"><bpmn:participant id="participante" name="TaskMiner — transformar o trabalho observado em backlog de melhoria" processRef="processo" /></bpmn:collaboration>
  <bpmn:process id="processo" isExecutable="false">
    <bpmn:laneSet id="raias"><bpmn:lane id="raia_admin" name="Administrador (gestor ou Scrum Master)"><bpmn:flowNodeRef>inicio</bpmn:flowNodeRef><bpmn:flowNodeRef>t_cadastrar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_revisar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_backlog</bpmn:flowNodeRef><bpmn:flowNodeRef>fim</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="raia_colab" name="Colaborador"><bpmn:flowNodeRef>t_instalar</bpmn:flowNodeRef><bpmn:flowNodeRef>g_termo</bpmn:flowNodeRef><bpmn:flowNodeRef>fim_cancel</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="raia_agente" name="Agente TaskMiner (Windows)"><bpmn:flowNodeRef>t_coletar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_enviar</bpmn:flowNodeRef><bpmn:flowNodeRef>g_periodo</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="raia_painel" name="Painel TaskMiner (servidor)"><bpmn:flowNodeRef>t_minerar</bpmn:flowNodeRef><bpmn:flowNodeRef>g_ia</bpmn:flowNodeRef><bpmn:flowNodeRef>t_claude</bpmn:flowNodeRef><bpmn:flowNodeRef>t_regras</bpmn:flowNodeRef><bpmn:flowNodeRef>g_junta</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Time quer melhorar seus processos"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t_cadastrar" name="Cadastrar colaborador com função e área"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task><bpmn:task id="t_instalar" name="Instalar o agente com o código pessoal"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g_termo" name="Aceita o termo de consentimento?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="fim_cancel" name="Coleta cancelada"><bpmn:incoming>f4</bpmn:incoming></bpmn:endEvent><bpmn:task id="t_coletar" name="Registrar janelas, sistemas, cliques e atalhos"><bpmn:incoming>f5</bpmn:incoming><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:task><bpmn:task id="t_enviar" name="Enviar eventos ao servidor"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g_periodo" name="Completou o período de coleta?"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t_minerar" name="Identificar processos repetidos e gargalos"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g_ia" name="Chave da API do Claude configurada?"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t_claude" name="Claude escreve o POP e as sugestões"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:task><bpmn:task id="t_regras" name="Gerador por regras escreve o POP"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g_junta" name=""><bpmn:incoming>f13</bpmn:incoming><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t_revisar" name="Revisar processos, gargalos e sugestões"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:task><bpmn:task id="t_backlog" name="Levar melhorias ao backlog do time"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:task><bpmn:endEvent id="fim" name="Backlog de melhoria atualizado"><bpmn:incoming>f17</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f1" name="" sourceRef="inicio" targetRef="t_cadastrar" /><bpmn:sequenceFlow id="f2" name="" sourceRef="t_cadastrar" targetRef="t_instalar" /><bpmn:sequenceFlow id="f3" name="" sourceRef="t_instalar" targetRef="g_termo" /><bpmn:sequenceFlow id="f4" name="Não" sourceRef="g_termo" targetRef="fim_cancel" /><bpmn:sequenceFlow id="f5" name="Sim" sourceRef="g_termo" targetRef="t_coletar" /><bpmn:sequenceFlow id="f6" name="" sourceRef="t_coletar" targetRef="t_enviar" /><bpmn:sequenceFlow id="f7" name="" sourceRef="t_enviar" targetRef="g_periodo" /><bpmn:sequenceFlow id="f8" name="Não" sourceRef="g_periodo" targetRef="t_coletar" /><bpmn:sequenceFlow id="f9" name="Sim" sourceRef="g_periodo" targetRef="t_minerar" /><bpmn:sequenceFlow id="f10" name="" sourceRef="t_minerar" targetRef="g_ia" /><bpmn:sequenceFlow id="f11" name="Sim" sourceRef="g_ia" targetRef="t_claude" /><bpmn:sequenceFlow id="f12" name="Não" sourceRef="g_ia" targetRef="t_regras" /><bpmn:sequenceFlow id="f13" name="" sourceRef="t_claude" targetRef="g_junta" /><bpmn:sequenceFlow id="f14" name="" sourceRef="t_regras" targetRef="g_junta" /><bpmn:sequenceFlow id="f15" name="" sourceRef="g_junta" targetRef="t_revisar" /><bpmn:sequenceFlow id="f16" name="" sourceRef="t_revisar" targetRef="t_backlog" /><bpmn:sequenceFlow id="f17" name="" sourceRef="t_backlog" targetRef="fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama"><bpmndi:BPMNPlane id="plano" bpmnElement="colaboracao"><bpmndi:BPMNShape id="part_di" bpmnElement="participante" isHorizontal="true"><dc:Bounds x="30" y="20" width="1600" height="600" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="raia_admin_di" bpmnElement="raia_admin" isHorizontal="true"><dc:Bounds x="60" y="20" width="1570" height="150" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="raia_colab_di" bpmnElement="raia_colab" isHorizontal="true"><dc:Bounds x="60" y="170" width="1570" height="150" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="raia_agente_di" bpmnElement="raia_agente" isHorizontal="true"><dc:Bounds x="60" y="320" width="1570" height="150" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="raia_painel_di" bpmnElement="raia_painel" isHorizontal="true"><dc:Bounds x="60" y="470" width="1570" height="150" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio"><dc:Bounds x="90" y="77" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_cadastrar_di" bpmnElement="t_cadastrar"><dc:Bounds x="160" y="63" width="130" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_instalar_di" bpmnElement="t_instalar"><dc:Bounds x="160" y="213" width="130" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="g_termo_di" bpmnElement="g_termo" isMarkerVisible="true"><dc:Bounds x="340" y="220" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="fim_cancel_di" bpmnElement="fim_cancel"><dc:Bounds x="470" y="227" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_coletar_di" bpmnElement="t_coletar"><dc:Bounds x="420" y="363" width="130" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_enviar_di" bpmnElement="t_enviar"><dc:Bounds x="590" y="363" width="130" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="g_periodo_di" bpmnElement="g_periodo" isMarkerVisible="true"><dc:Bounds x="770" y="370" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_minerar_di" bpmnElement="t_minerar"><dc:Bounds x="750" y="513" width="130" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="g_ia_di" bpmnElement="g_ia" isMarkerVisible="true"><dc:Bounds x="930" y="520" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_claude_di" bpmnElement="t_claude"><dc:Bounds x="1030" y="477" width="130" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_regras_di" bpmnElement="t_regras"><dc:Bounds x="1030" y="549" width="130" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="g_junta_di" bpmnElement="g_junta" isMarkerVisible="true"><dc:Bounds x="1200" y="520" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_revisar_di" bpmnElement="t_revisar"><dc:Bounds x="1180" y="63" width="130" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_backlog_di" bpmnElement="t_backlog"><dc:Bounds x="1350" y="63" width="130" height="64" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="fim_di" bpmnElement="fim"><dc:Bounds x="1530" y="77" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="126" y="95" /><di:waypoint x="160" y="95" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="225" y="127" /><di:waypoint x="225" y="213" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="290" y="245" /><di:waypoint x="340" y="245" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="390" y="245" /><di:waypoint x="470" y="245" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="365" y="270" /><di:waypoint x="365" y="395" /><di:waypoint x="420" y="395" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="550" y="395" /><di:waypoint x="590" y="395" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="720" y="395" /><di:waypoint x="770" y="395" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="795" y="370" /><di:waypoint x="795" y="334" /><di:waypoint x="485" y="334" /><di:waypoint x="485" y="363" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="795" y="420" /><di:waypoint x="795" y="466" /><di:waypoint x="815" y="466" /><di:waypoint x="815" y="513" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="880" y="545" /><di:waypoint x="930" y="545" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="955" y="520" /><di:waypoint x="955" y="509" /><di:waypoint x="1030" y="509" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><di:waypoint x="955" y="570" /><di:waypoint x="955" y="581" /><di:waypoint x="1030" y="581" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><di:waypoint x="1160" y="509" /><di:waypoint x="1225" y="509" /><di:waypoint x="1225" y="520" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f14_di" bpmnElement="f14"><di:waypoint x="1160" y="581" /><di:waypoint x="1225" y="581" /><di:waypoint x="1225" y="570" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f15_di" bpmnElement="f15"><di:waypoint x="1225" y="520" /><di:waypoint x="1225" y="324" /><di:waypoint x="1245" y="324" /><di:waypoint x="1245" y="127" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f16_di" bpmnElement="f16"><di:waypoint x="1310" y="95" /><di:waypoint x="1350" y="95" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f17_di" bpmnElement="f17"><di:waypoint x="1480" y="95" /><di:waypoint x="1530" y="95" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
